# 站点正式地址，用于 canonical、OG 与站点地图
NEXT_PUBLIC_SITE_URL=https://lab.anahgo.com

# 管理入口通行码（占位）。后端接入后由服务端签发会话，此值不再承担安全职责
NEXT_PUBLIC_ADMIN_PASSPHRASE=anahgo-lab

# 后端 API 地址（Coolify 部署后填写），现阶段前端使用构建期常量数据
# NEXT_PUBLIC_API_BASE_URL=https://api.lab.anahgo.com

# 搜索引擎站点验证。留空则不输出对应 meta 标签
# NEXT_PUBLIC_VERIFY_GOOGLE=
# NEXT_PUBLIC_VERIFY_BING=
# NEXT_PUBLIC_VERIFY_YANDEX=
# NEXT_PUBLIC_VERIFY_BAIDU=

# 组织信息，会进入结构化数据的 Organization 节点
# NEXT_PUBLIC_GITHUB_URL=
# NEXT_PUBLIC_CONTACT_EMAIL=
